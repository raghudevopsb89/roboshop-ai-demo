# Copy to profiles/<yourname>.env and fill in. Everything here is per-person:
# your own Foundry account, your own deployment names.
#
# Generate the Foundry half automatically instead of typing it:
#     cd ../infra && ENV=<yourname> make profile
#
# Use it with either:
#     ROBOSHOP_PROFILE=<yourname> python3 ask_rag.py 1
#     source profiles/<yourname>.env && python3 ask_rag.py 1
#
# This file is the ONLY committed one. profiles/*.env is gitignored, because
# AZURE_KEY and MONGO_URL are secrets.

# ---- Foundry (needed by every script) -----------------------------------
# From: cd ../infra && ENV=<yourname> make env
export AZURE_BASE="https://roboshop-<yourname>-foundry.openai.azure.com/openai/v1"
export AZURE_KEY="<primary access key>"

# DEPLOYMENT names from your own main.tfvars, not model names.
export CHAT_MODEL="gpt-5-mini"
export EMBED_MODEL="text-embedding-3-small"

# ---- Live databases (needed by ask_live.py only) ------------------------
# From the azure-services stack, NOT ../infra:
#   cd ../../azure-services/infra && terraform output mysql_host
# Only reachable from the RHEL VM inside workstation-vnet.
export MYSQL_HOST=""
export MYSQL_USER="roboshopadmin"
export MYSQL_PASSWORD=""
export MYSQL_DATABASE="catalogue"

# terraform output -json mongo_urls | jq -r .orders   -- contains the Cosmos key
export MONGO_URL=""
